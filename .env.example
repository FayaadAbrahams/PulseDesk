# Copy to .env (gitignored) to override the local defaults in compose.yaml.
# Every value is optional; compose.yaml falls back to development defaults.

MYSQL_DATABASE=pulsedesk
MYSQL_USER=pulsedesk
MYSQL_PASSWORD=pulsedesk-dev
MYSQL_ROOT_PASSWORD=pulsedesk-root-dev

# HS256 signing key: at least 32 characters.
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
JWT_ISSUER=PulseDesk
JWT_AUDIENCE=PulseDesk
JWT_EXPIRY_DAYS=7
