{
  "name": "pulse-desk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "services/sla"
  ],
  "scripts": {
    "dev": "conc -c yellow,blue -n web,sla --kill-others-on-fail \"npm run dev -w apps/web\" \"npm run dev -w services/sla\" ",
    "build": "npm run build --workspaces --if-present",
    "test:watch": "vitest",
    "test": "vitest run",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prettier": "3.9.10",
    "vitest": "^5.1.0"
  }
}
