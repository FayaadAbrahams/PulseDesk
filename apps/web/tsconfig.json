{
  "compilerOptions": {
    "target": "ES2020",
    "composite": true,
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": ["node"],
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "include": [
        "./src",
        "./src/declarations.d.ts"
      ]
    }
  },
  "include": [
    "src",
    ".react-router/types/**/*"
  ]
}
